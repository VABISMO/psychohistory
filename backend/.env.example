# MongoDB connection string. Falls back to an in-memory mongomock instance if unreachable.
MONGO_URI="mongodb://mongo:27017/"

# Ollama server endpoint (local LLM inference).
OLLAMA_HOST="http://localhost:11434"

# How long Ollama keeps a model resident after a prediction. On RAM-bound CPU
# boxes a shorter value (or "-1" = forever / "0" = unload immediately) avoids
# holding large models in memory between runs.
# PSYCHO_KEEP_ALIVE="5m"

# Unload any other resident model before a prediction so only one model is ever
# held in RAM at a time. Set PSYCHO_SINGLE_MODEL=0 to allow multiple.
# PSYCHO_SINGLE_MODEL="1"

# Optional extra data providers (Wikidata, GDELT, World Bank, IMF, PredictIt) are
# keyless and on by default. Set PSYCHO_DATASOURCES=0 to disable them all.
# PSYCHO_DATASOURCES="1"

# ACLED armed-conflict events are optional and require a (free) API key + email.
# ACLED_API_KEY=""
# ACLED_EMAIL=""
